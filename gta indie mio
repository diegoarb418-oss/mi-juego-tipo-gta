<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Juego PRO</title>

<style>
body { margin:0; overflow:hidden; background:black; color:white; font-family:Arial; }

#menu, #pauseMenu {
  position:absolute;
  width:100%; height:100%;
  background:rgba(0,0,0,0.9);
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
}

button { padding:15px; margin:10px; font-size:18px; }

#ui { position:absolute; top:10px; left:10px; }

#healthBar { width:200px; height:20px; background:red; }
#health { height:100%; background:lime; }

#mission { position:absolute; top:10px; right:10px; color:cyan; }

/* Joystick */
#joystick {
  position:absolute;
  bottom:80px;
  left:80px;
  width:100px;
  height:100px;
  background:rgba(255,255,255,0.2);
  border-radius:50%;
  display:none;
}

#stick {
  width:40px;
  height:40px;
  background:white;
  border-radius:50%;
  position:absolute;
  top:30px;
  left:30px;
}
</style>
</head>

<body>

<div id="menu">
  <h1>MI JUEGO</h1>
  <button onclick="choosePlatform()">Jugar</button>
</div>

<div id="pauseMenu" style="display:none;">
  <h1>PAUSA</h1>
  <button onclick="resume()">Continuar</button>
  <button onclick="alert(controlsText)">Ver Controles</button>
</div>

<canvas id="gameCanvas"></canvas>

<div id="ui">
  <div id="playerName"></div>
  <div id="healthBar"><div id="health"></div></div>
</div>

<div id="mission"></div>

<!-- Joystick -->
<div id="joystick">
  <div id="stick"></div>
</div>

<script>
let isMobile = false;
let gameStarted = false;
let paused = false;

const controlsText = "PC: WASD + Click | Móvil: Joystick + toque para disparar";

const canvas = document.getElementById("gameCanvas");
const ctx = canvas.getContext("2d");
canvas.width = window.innerWidth;
canvas.height = window.innerHeight;

// Sonido
const shootSound = new Audio("https://www.soundjay.com/button/sounds/button-16.mp3");

// Jugador
let player = {x:500,y:500,health:100};
let playerName = "";

// Enemigos
let enemies = [{x:700,y:500,health:100}];

// Balas
let bullets = [];

// Misión
let mission = { text: "Elimina 1 enemigo", completed: false };

// =====================
// DETECTAR PLATAFORMA
// =====================
function choosePlatform(){
  let choice = confirm("¿Estás en móvil? OK = Sí / Cancelar = PC");
  isMobile = choice;

  if(isMobile){
    document.getElementById("joystick").style.display = "block";
  }

  startGame();
}

// =====================
// CONTROLES PC
// =====================
let keys = {};
document.addEventListener("keydown", e=>{
  keys[e.key.toLowerCase()] = true;

  if(e.key==="Escape" && gameStarted){
    paused = !paused;
    document.getElementById("pauseMenu").style.display = paused?"flex":"none";
  }
});
document.addEventListener("keyup", e=> keys[e.key.toLowerCase()] = false);

// =====================
// JOYSTICK MÓVIL
// =====================
let joystick = document.getElementById("joystick");
let stick = document.getElementById("stick");
let joyActive = false;
let joyX=0, joyY=0;

joystick.addEventListener("touchstart", ()=> joyActive=true);
joystick.addEventListener("touchend", ()=>{
  joyActive=false;
  joyX=0; joyY=0;
  stick.style.left="30px";
  stick.style.top="30px";
});

joystick.addEventListener("touchmove", e=>{
  let touch = e.touches[0];
  let rect = joystick.getBoundingClientRect();

  joyX = touch.clientX - (rect.left+50);
  joyY = touch.clientY - (rect.top+50);

  stick.style.left = (30+joyX*0.5)+"px";
  stick.style.top = (30+joyY*0.5)+"px";
});

// =====================
// START
// =====================
function startGame(){
  playerName = prompt("Tu nombre:");
  document.getElementById("playerName").innerText = playerName;
  document.getElementById("menu").style.display="none";
  gameStarted = true;
}

// =====================
// MOVIMIENTO
// =====================
function movePlayer(){
  if(isMobile){
    player.x += joyX*0.05;
    player.y += joyY*0.05;
  } else {
    if(keys["w"]) player.y-=3;
    if(keys["s"]) player.y+=3;
    if(keys["a"]) player.x-=3;
    if(keys["d"]) player.x+=3;
  }
}

// =====================
// DISPARO
// =====================
document.addEventListener("click", ()=>{
  if(gameStarted && !paused){
    bullets.push({x:player.x,y:player.y});
    shootSound.play();
  }
});

canvas.addEventListener("touchstart", ()=>{
  if(isMobile){
    bullets.push({x:player.x,y:player.y});
    shootSound.play();
  }
});

// =====================
// BALAS
// =====================
function updateBullets(){
  bullets.forEach(b=>{
    b.x+=5;
    ctx.fillStyle="yellow";
    ctx.fillRect(b.x,b.y,5,5);

    enemies.forEach(e=>{
      if(Math.hypot(b.x-e.x,b.y-e.y)<20 && e.health>0){
        e.health=0;
        mission.completed = true;
      }
    });
  });
}

// =====================
// ENEMIGOS
// =====================
function drawEnemies(){
  enemies.forEach(e=>{
    if(e.health>0){
      ctx.fillStyle="red";
      ctx.fillRect(e.x,e.y,20,20);
    }
  });
}

// =====================
// JUGADOR
// =====================
function drawPlayer(){
  ctx.fillStyle="blue";
  ctx.fillRect(player.x,player.y,20,20);
}

// =====================
// UI
// =====================
function updateUI(){
  document.getElementById("health").style.width = player.health+"%";
  document.getElementById("mission").innerText =
    mission.completed ? "Misión completada ✅" : mission.text;
}

// =====================
// LOOP
// =====================
function gameLoop(){
  ctx.clearRect(0,0,canvas.width,canvas.height);

  if(gameStarted && !paused){
    movePlayer();
    updateBullets();
    drawEnemies();
    drawPlayer();
    updateUI();
  }

  requestAnimationFrame(gameLoop);
}

gameLoop();
</script>

</body>
</html>